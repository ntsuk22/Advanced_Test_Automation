<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- thread-count is overridden at runtime by utils.SuiteConfigListener (config.properties / -Dthreads) -->
<suite name="TBC Digital - Advanced Test Automation" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="utils.SuiteConfigListener"/>
    </listeners>

    <test name="Playwright UI">
        <classes>
            <class name="tests.LocationsTest"/>
            <class name="tests.ExchangeRatesTest"/>
            <class name="tests.SiteSearchTest"/>
        </classes>
    </test>

    <test name="Localization">
        <classes>
            <class name="tests.LocalizationTest"/>
        </classes>
    </test>

    <test name="SQL data-driven">
        <classes>
            <class name="tests.CurrencyConverterDataDrivenTest"/>
        </classes>
    </test>

    <test name="API">
        <classes>
            <class name="tests.ExchangeRatesApiTest"/>
        </classes>
    </test>
</suite>
